---
import { glance } from '../data/site';
---

<section class="glance surface-ivory" aria-label="Care at a glance">
  <div class="container-site glance__row reveal">
    <p class="glance__title">Care at a glance</p>
    <ul class="glance__list">
      {glance.map((g) => <li>{g}</li>)}
    </ul>
  </div>
</section>

<style>
  .glance {
    border-bottom: 1px solid rgb(12 59 54 / 0.1);
    padding-block: 18px;
  }
  .glance__row {
    display: grid;
    gap: 0.8rem;
    align-items: center;
  }
  .glance__title {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-teal);
  }
  .glance__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .glance__list li {
    padding: 0.35rem 0.8rem;
    border: 1px solid rgb(12 59 54 / 0.16);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-ink) 82%, transparent);
    background: rgb(255 255 255 / 0.5);
  }

  /* Desktop: one editorial line with fine separators instead of pills */
  @media (min-width: 960px) {
    .glance__row {
      grid-template-columns: auto 1fr;
      gap: 2rem;
    }
    .glance__list {
      flex-wrap: nowrap;
      gap: 0;
      justify-content: space-between;
    }
    .glance__list li {
      padding: 0 1.1rem;
      border: 0;
      border-left: 1px solid rgb(12 59 54 / 0.18);
      border-radius: 0;
      background: none;
      white-space: nowrap;
    }
    .glance__list li:first-child {
      border-left: 0;
      padding-left: 0;
    }
    .glance__list li:last-child {
      padding-right: 0;
    }
  }
</style>
