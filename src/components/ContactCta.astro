---
import Icon from './Icon.astro';
import { clinic, hours, links } from '../data/site';
const { address } = clinic;
---

<section id="contact" class="cta on-dark" data-section data-ambient data-hide-sticky aria-labelledby="contact-title">
  <div class="bg" aria-hidden="true">
    <svg class="rings" viewBox="0 0 900 900" focusable="false" aria-hidden="true">
      <g fill="none" stroke="#E9DFC9" stroke-opacity=".14">
        <circle cx="450" cy="450" r="140"></circle>
        <circle cx="450" cy="450" r="230" stroke-dasharray="3 10"></circle>
        <circle cx="450" cy="450" r="320"></circle>
        <circle cx="450" cy="450" r="410" stroke-dasharray="1 9"></circle>
      </g>
    </svg>
    <span class="orb" style="--s:560px; --c:rgb(45 156 146 / .5); left:-140px; top:-160px; --dur:34s"></span>
    <span class="orb" style="--s:480px; --c:rgb(12 59 54 / .9); right:-120px; bottom:-160px; --dur:40s"></span>
  </div>

  <div class="container-site">
    <div class="panel glass-dark reveal">
      <p class="eyebrow">Get in touch</p>
      <h2 id="contact-title" class="h2">Not sure where to start?</h2>
      <p class="lead">Tell us what you’re experiencing and we’ll help you take the next step.</p>

      <div class="buttons">
        <a class="btn btn-primary" href={links.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-location="contact-cta">
          <Icon name="message-circle" size={20} />
          WhatsApp the Clinic
          <Icon name="arrow-right" size={18} class="icon-arrow" />
        </a>
        <a class="btn btn-glass" href={links.tel} data-track="phone_click" data-location="contact-cta">
          <Icon name="phone" size={18} />
          Call the Clinic
        </a>
      </div>

      <p class="fine">
        <a href={links.tel} data-track="phone_click" data-location="contact-cta-number">{clinic.phone.display}</a>
        <span aria-hidden="true">·</span>
        {hours.days} {hours.sessions.join(' & ')} · {hours.closed}
      </p>
    </div>

    <div class="visit reveal" style="--i:1">
      <p class="visit__title">Before you visit</p>
      <dl class="visit__grid">
        <div>
          <dt><Icon name="map-pin" size={14} /> Location</dt>
          <dd>{address.street}<br />Gomti Nagar, {address.city}</dd>
        </div>
        <div>
          <dt><Icon name="clock" size={14} /> Timings</dt>
          <dd>{hours.days}<br />{hours.sessions.join(' · ')}</dd>
        </div>
        <div>
          <dt><Icon name="phone" size={14} /> Contact</dt>
          <dd><a href={links.tel} data-track="phone_click" data-location="before-you-visit">{clinic.phone.display}</a></dd>
        </div>
      </dl>
      <a class="link-arrow visit__link" href={links.directions} target="_blank" rel="noopener noreferrer" data-track="directions_click" data-location="before-you-visit">
        Get Directions
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: clip;
    padding-block: clamp(64px, 4.5vw + 34px, 96px);
    background: linear-gradient(135deg, #0f766e 0%, #0c5a53 45%, var(--color-pine) 100%);
    color: var(--color-ivory);
  }
  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .rings {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(1000px, 160vw);
    margin: calc(min(1000px, 160vw) / -2) 0 0 calc(min(1000px, 160vw) / -2);
  }
  .panel {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1rem;
    max-width: 880px;
    margin-inline: auto;
    padding: clamp(1.75rem, 1rem + 2.6vw, 3rem) clamp(1.25rem, 0.5rem + 3vw, 3rem);
    border-radius: 32px;
    text-align: center;
  }
  .panel .eyebrow::after {
    content: '';
    width: 28px;
    height: 1.5px;
    background: currentColor;
    opacity: 0.7;
  }
  .panel .lead {
    max-width: 32rem;
  }
  .buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 480px;
    margin-top: 0.75rem;
  }
  .fine {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.7;
    color: rgb(250 248 242 / 0.72);
  }
  .fine a {
    font-weight: 700;
    color: var(--color-ivory);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .fine span {
    margin-inline: 0.25rem;
  }

  /* Before you visit — a compact fact strip, not a second Visit section */
  .visit {
    display: grid;
    gap: 1rem;
    max-width: 880px;
    margin: 1.25rem auto 0;
    padding: 1.1rem 0.25rem 0;
  }
  .visit__title {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-sand);
  }
  .visit__grid {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }
  .visit__grid dt {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.2rem;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(250 248 242 / 0.6);
  }
  .visit__grid dd {
    margin: 0;
    font-size: 0.9688rem;
    line-height: 1.5;
    color: var(--color-ivory);
  }
  .visit__grid a {
    font-weight: 700;
    color: var(--color-ivory);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgb(250 248 242 / 0.4);
  }
  .visit__link {
    justify-self: start;
  }
  @media (min-width: 768px) {
    .visit {
      grid-template-columns: auto 1fr auto;
      align-items: end;
      gap: 2rem;
    }
    .visit__title {
      align-self: start;
      padding-top: 0.2rem;
    }
    .visit__grid {
      grid-template-columns: repeat(3, auto);
      justify-content: space-between;
      gap: 2rem;
    }
  }

  @media (min-width: 560px) {
    .buttons {
      flex-direction: row;
      justify-content: center;
      max-width: none;
      width: auto;
    }
  }
</style>
