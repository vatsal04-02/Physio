---
import ClinicImage from './ClinicImage.astro';
import Placeholder from './Placeholder.astro';
import { gallery } from '../data/site';

const meta = {
  clinic: { icon: 'building-2', tone: 'pine' },
  reception: { icon: 'armchair', tone: 'teal' },
  'treatment-room': { icon: 'bed-single', tone: 'teal' },
  equipment: { icon: 'dumbbell', tone: 'pine' },
} as const;
---

<section id="clinic" class="section surface-sand" data-section data-ambient aria-labelledby="clinic-title">
  <div class="bg" aria-hidden="true">
    <span class="orb" style="--s:480px; --c:rgb(255 255 255 / .5); right:-140px; bottom:-80px; --dur:46s"></span>
  </div>

  <div class="container-site relative">
    <header class="head reveal">
      <div class="head__title">
        <p class="eyebrow">04 / Clinic experience</p>
        <h2 id="clinic-title" class="h2">A closer look at the clinic.</h2>
      </div>
      <p class="lead head__lead">A look inside Geeta Krishna Physiotherapy in Viram Khand, Gomti Nagar.</p>
    </header>

    <ul class="mosaic">
      {
        gallery.map((g, i) => (
          <li class:list={['tile reveal reveal-scale', `tile--${g.key}`]} style={`--i:${i}`}>
            <figure>
              <div class="tile__media">
                <ClinicImage photo={g.slot} alt={g.alt} sizes="(min-width:1024px) 720px, (min-width:640px) 50vw, 100vw">
                  <Placeholder label="Photograph" icon={meta[g.key].icon} tone={meta[g.key].tone} tag="[TBD - clinic photo]" />
                </ClinicImage>
              </div>
              <figcaption class="tile__cap glass">{g.label}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .relative {
    position: relative;
  }
  .head {
    display: grid;
    gap: 0.9rem;
    margin-bottom: clamp(24px, 3.5vw, 40px);
  }
  .head__title {
    display: grid;
    gap: 0.8rem;
  }

  .mosaic {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 150px;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tile {
    position: relative;
    min-height: 0;
  }
  .tile figure,
  .tile__media {
    height: 100%;
    margin: 0;
  }
  .tile__media {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    background: var(--color-pine);
    box-shadow: 0 20px 34px -26px rgb(12 59 54 / 0.55);
    isolation: isolate;
  }
  .tile__media :global(.clinic-img) {
    transition: transform 900ms var(--ease-soft);
  }
  .tile:hover .tile__media :global(.clinic-img) {
    transform: scale(1.02);
  }
  .tile__cap {
    position: absolute;
    left: 10px;
    bottom: 10px;
    z-index: 3;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-pine);
  }

  /* Smaller tiles carry just the icon + tag so the caption chip never collides */
  .tile:not(.tile--clinic) :global(.ph__label) {
    display: none;
  }
  .tile:not(.tile--clinic) :global(.ph) {
    padding-bottom: 2.75rem;
  }

  /* Mobile: lead photo full width, then a pair, then a wide detail */
  .tile--clinic {
    grid-column: 1 / -1;
    grid-row: span 2;
  }
  .tile--equipment {
    grid-column: 1 / -1;
  }

  @media (min-width: 640px) {
    .mosaic {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-auto-rows: 180px;
      gap: 14px;
    }
    .tile--clinic {
      grid-column: span 6;
      grid-row: span 2;
    }
    .tile--reception,
    .tile--treatment-room {
      grid-column: span 3;
    }
    .tile--equipment {
      grid-column: span 6;
      grid-row: span 1;
    }
    .tile__media {
      border-radius: 22px;
    }
  }

  /* Desktop: asymmetric editorial mosaic — one lead image, a wide, a medium, a small detail */
  @media (min-width: 1024px) {
    .head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
      gap: 32px;
    }
    .head__title {
      grid-column: 1 / span 6;
    }
    .head__lead {
      grid-column: 8 / span 5;
    }
    .mosaic {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-rows: 190px;
      gap: 16px;
    }
    .tile--clinic {
      grid-column: 1 / span 7;
      grid-row: 1 / span 2;
    }
    .tile--reception {
      grid-column: 8 / span 5;
      grid-row: 1;
    }
    .tile--treatment-room {
      grid-column: 8 / span 3;
      grid-row: 2;
    }
    .tile--equipment {
      grid-column: 11 / span 2;
      grid-row: 2;
    }
    .tile__media {
      border-radius: 26px;
    }
    .tile__cap {
      left: 14px;
      bottom: 14px;
      font-size: 0.8125rem;
    }
  }
</style>
