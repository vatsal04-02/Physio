---
import ClinicImage from './ClinicImage.astro';
import Icon from './Icon.astro';
import { gallery } from '../data/site';

const icons = {
  exterior: 'building-2',
  reception: 'armchair',
  'treatment-room': 'bed-single',
  equipment: 'dumbbell',
  signage: 'signpost',
} as const;
---

<section id="clinic" class="section surface-sand" data-section data-ambient aria-labelledby="clinic-title">
  <div class="bg" aria-hidden="true">
    <span class="orb" style="--s:560px; --c:rgb(15 118 110 / .16); left:-160px; top:-60px; --dur:38s"></span>
    <span class="orb" style="--s:520px; --c:rgb(255 255 255 / .55); right:-140px; bottom:-80px; --dur:44s"></span>
  </div>

  <div class="container-site relative">
    <header class="head reveal">
      <p class="eyebrow">Clinic experience</p>
      <h2 id="clinic-title" class="h2">See the space before you visit.</h2>
      <p class="lead">A look inside Geeta Krishna Physiotherapy, in Viram Khand, Gomti Nagar.</p>
    </header>

    <ul class="mosaic">
      {
        gallery.map((g, i) => (
          <li class:list={['tile reveal reveal-scale', `tile--${g.slot}`]} style={`--i:${i}`}>
            <figure>
              <div class="tile__media">
                <ClinicImage slot={g.slot} alt={g.alt} sizes="(min-width:1024px) 720px, (min-width:640px) 50vw, 100vw">
                  <div class={`ph ph--${i % 3}`}>
                    <div class="dots"></div>
                    <svg class="ph__rings" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
                      <circle cx="100" cy="100" r="46" fill="none" stroke="#E9DFC9" stroke-opacity=".2"></circle>
                      <circle cx="100" cy="100" r="76" fill="none" stroke="#E9DFC9" stroke-opacity=".14" stroke-dasharray="2 7"></circle>
                      <circle cx="100" cy="100" r="98" fill="none" stroke="#E9DFC9" stroke-opacity=".1"></circle>
                    </svg>
                    <Icon name={icons[g.slot]} size={34} strokeWidth={1.4} class="ph__icon" />
                    <span class="ph-tag" data-placeholder>[TBD - clinic photo]</span>
                  </div>
                </ClinicImage>
              </div>
              <figcaption class="tile__cap glass">{g.label}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .relative {
    position: relative;
  }
  .head {
    display: grid;
    gap: 1.1rem;
    max-width: 40rem;
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  .mosaic {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 168px;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tile {
    position: relative;
    min-height: 0;
  }
  .tile figure,
  .tile__media {
    height: 100%;
    margin: 0;
  }
  .tile__media {
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    background: var(--color-pine);
    box-shadow: 0 24px 40px -28px rgb(12 59 54 / 0.55);
    isolation: isolate;
  }
  .tile__media :global(.clinic-img) {
    transition: transform 900ms var(--ease-soft);
  }
  .tile:hover .tile__media :global(.clinic-img) {
    transform: scale(1.02);
  }
  .tile__cap {
    position: absolute;
    left: 10px;
    bottom: 10px;
    z-index: 3;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-pine);
  }

  /* Mobile: one hero tile, then pairs */
  .tile--exterior {
    grid-column: 1 / -1;
    grid-row: span 2;
  }

  /* Placeholder tiles */
  .ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-sand);
  }
  .ph--0 {
    background: radial-gradient(120% 90% at 20% 0%, #14574f, var(--color-pine) 62%, #082e2a);
  }
  .ph--1 {
    background: radial-gradient(120% 90% at 80% 0%, #0f766e, #0c4a45 60%, var(--color-pine));
  }
  .ph--2 {
    background: radial-gradient(110% 90% at 50% 100%, #14574f, #0a3531 65%, #082e2a);
  }
  .ph__rings {
    position: absolute;
    width: 78%;
    max-width: 320px;
  }
  .ph :global(.ph__icon) {
    position: relative;
    opacity: 0.85;
  }
  .ph-tag {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    border: 1px dashed rgb(233 223 201 / 0.5);
    background: rgb(12 59 54 / 0.5);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  @media (min-width: 640px) {
    .mosaic {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-auto-rows: 200px;
      gap: 16px;
    }
    .tile--exterior {
      grid-column: span 6;
      grid-row: span 2;
    }
    .tile--reception,
    .tile--treatment-room {
      grid-column: span 3;
    }
    .tile--equipment {
      grid-column: span 2;
    }
    .tile--signage {
      grid-column: span 4;
    }
  }

  /* Desktop: asymmetric editorial mosaic */
  @media (min-width: 1024px) {
    .mosaic {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-rows: 190px;
      gap: 20px;
    }
    .tile--exterior {
      grid-column: 1 / span 7;
      grid-row: 1 / span 2;
    }
    .tile--reception {
      grid-column: 8 / span 5;
      grid-row: 1;
    }
    .tile--treatment-room {
      grid-column: 8 / span 5;
      grid-row: 2;
    }
    .tile--equipment {
      grid-column: 1 / span 4;
      grid-row: 3;
    }
    .tile--signage {
      grid-column: 5 / span 8;
      grid-row: 3;
    }
    .tile__media {
      border-radius: 28px;
    }
    .tile__cap {
      left: 16px;
      bottom: 16px;
      padding: 0.45rem 0.95rem;
      font-size: 0.875rem;
    }
  }
</style>
