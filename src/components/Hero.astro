---
import Depth from './Depth.astro';
import ClinicImage from './ClinicImage.astro';
import Icon from './Icon.astro';
import { clinic, hours, links, schedule } from '../data/site';

// Server-rendered fallback for the live pill (no JS / before hydration): the plain hours.
const fallback = `${hours.days} · ${hours.sessions.join(' · ')}`;
---

<section id="top" class="hero" data-section data-ambient aria-labelledby="hero-title">
  <Depth tone="light" glow />

  <div class="container-site hero__grid">
    <div class="hero__copy">
      <p class="eyebrow rise" style="--d:0ms">Local Physiotherapy • Gomti Nagar</p>

      <h1 id="hero-title" class="display hero__title rise" style="--d:90ms">
        Physiotherapy that puts an <em class="accent-italic">expiry date</em> on your pain.
      </h1>

      <p class="lead hero__lead rise" style="--d:180ms">
        Two MPT doctors. One clear plan. Zero guesswork — in Gomti Nagar, Lucknow.
      </p>

      <div id="hero-cta" class="hero__cta rise" style="--d:270ms" data-hero-cta>
        <a class="btn btn-primary btn-glow" href={links.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-location="hero">
          <Icon name="message-circle" size={20} />
          WhatsApp the Clinic
          <Icon name="arrow-right" size={18} class="icon-arrow" />
        </a>
        <a class="btn btn-outline" href={links.tel} data-track="phone_click" data-location="hero">
          <Icon name="phone" size={18} />
          Call the Clinic
        </a>
      </div>

      <div class="badges rise" style="--d:360ms">
        <div class="rating glass">
          <span class="stars" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => <Icon name="star" size={15} class="star" />)}
          </span>
          <span class="rating__text">
            <strong data-live-rating>{clinic.rating.value}</strong> · <span data-live-count>{clinic.rating.count}</span> Google reviews
          </span>
          <span class="sr-only" data-live-text="Rated {rating} out of 5 stars from {count} Google reviews">Rated {clinic.rating.value} out of 5 stars from {clinic.rating.count} Google reviews</span>
        </div>

        <!-- Live status, computed in the browser against clinic time (IST) -->
        <p class="status glass" data-open-status data-schedule={JSON.stringify(schedule)}>
          <span class="status__dot" aria-hidden="true"></span>
          <span data-status-text>{fallback}</span>
        </p>
      </div>
    </div>

    <div class="hero__visual">
      <!-- Floating rhythm around the photograph: one slowly turning dotted ring, a few drifting marks,
           and a soft light that breathes under the frame. The photo itself never moves. -->
      <span class="hero__orbit drift" aria-hidden="true">
        <svg viewBox="0 0 400 400" focusable="false">
          <circle cx="200" cy="200" r="199" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="1 9" vector-effect="non-scaling-stroke"></circle>
          <circle cx="200" cy="200" r="199" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="120 1130" vector-effect="non-scaling-stroke"></circle>
          <circle cx="200" cy="1" r="4.5" fill="currentColor"></circle>
        </svg>
      </span>
      <span class="hero__marks hero__marks--a drift" aria-hidden="true"></span>
      <span class="hero__marks hero__marks--b drift" aria-hidden="true"></span>
      <span class="hero__under drift" aria-hidden="true"></span>
      <span class="hero__outline" aria-hidden="true"></span>
      <figure class="frame">
        <div class="frame__media" data-parallax>
          <div class="frame__scale">
            <!-- Until a real hero photo (src/assets/clinic/hero.*) exists, this designed panel fills the frame. -->
            <ClinicImage photo="hero" alt="Inside Geeta Krishna Physiotherapy, Gomti Nagar, Lucknow" sizes="(min-width:1024px) 560px, 100vw" priority>
              <div class="panel">
                <span class="panel__dots" aria-hidden="true"></span>
                <svg class="panel__arcs" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
                  <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
                    <circle cx="400" cy="0" r="150"></circle>
                    <circle cx="400" cy="0" r="230"></circle>
                    <circle cx="400" cy="0" r="310" stroke-dasharray="2 8"></circle>
                  </g>
                </svg>
                <div class="panel__inner">
                <p class="panel__badge">
                  <span class="panel__score"><strong data-live-rating>{clinic.rating.value}</strong><Icon name="star" size={15} class="panel__star" /></span>
                  <span class="panel__rule" aria-hidden="true"></span>
                  <span class="panel__src"><span data-live-count>{clinic.rating.count}</span> Google reviews</span>
                </p>
                <div class="panel__body">
                  <p class="panel__eyebrow">{clinic.name}</p>
                  <p class="panel__line">Gomti Nagar’s <em>trusted</em> physio clinic</p>
                </div>
                </div>
              </div>
            </ClinicImage>
          </div>
        </div>
        <figcaption class="frame__cap">
          <Icon name="map-pin" size={13} /> Viram Khand, Gomti Nagar
        </figcaption>
      </figure>

      <div class="hours-card glass drift" style="--d:720ms">
        <p class="hours-card__label"><Icon name="clock" size={13} /> Clinic Hours</p>
        <p class="hours-card__main">{hours.days} · {hours.sessions[0]}</p>
        <p class="hours-card__sub">{hours.sessions[1]} · {hours.closed}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-top: calc(var(--header-h) + 12px);
    padding-bottom: clamp(52px, 5vw, 72px);
  }
  .hero__grid {
    position: relative;
    display: grid;
    gap: 36px;
    align-items: center;
  }

  /* ---- Copy ---- */
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .hero__title {
    margin-top: 0.9rem;
    max-width: 17ch;
    color: var(--color-ink);
  }
  .hero__lead {
    max-width: 30rem;
    margin-top: 1.1rem;
  }
  .hero__cta {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    width: 100%;
    margin-top: 1.6rem;
  }
  .hero__cta .btn {
    width: 100%;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  .rating,
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0.5rem 0.95rem 0.5rem 0.8rem;
    border-radius: 999px;
    font-size: 0.875rem;
    line-height: 1.2;
  }
  .stars {
    display: inline-flex;
    gap: 2px;
    color: var(--star, #c8932a);
  }
  .stars :global(.star) {
    fill: currentColor;
    stroke-width: 1.5;
  }
  .rating strong {
    font: 400 1.1875rem/1 var(--font-serif);
  }

  /* Live open/closed pill */
  .status {
    font-weight: 600;
    color: var(--color-ink);
  }
  .status__dot {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-ink) 40%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-ink) 12%, transparent);
    transition: background-color var(--dur-normal) ease, box-shadow var(--dur-normal) ease;
  }
  .status[data-state='open'] .status__dot {
    background: var(--color-teal);
    box-shadow: 0 0 0 3px rgb(15 118 110 / 0.2);
  }
  .status[data-state='open'] {
    color: var(--color-pine);
  }

  /* ---- Photo-led visual ---- */
  .hero__visual {
    position: relative;
    padding: 0 0 26px 0;
  }
  /* Fine-line offset frame: controlled overlap, no heavy decoration */
  .hero__outline {
    position: absolute;
    inset: 14px -10px 12px 14px;
    border: 1px solid rgb(15 118 110 / 0.35);
    border-radius: 28px;
    pointer-events: none;
  }
  /* ---- Designed panel (fills the frame until a real photograph is supplied) ---- */
  .panel {
    position: absolute;
    inset: 0;
    color: var(--color-ivory);
    background:
      radial-gradient(90% 70% at 85% 0%, rgb(45 156 146 / 0.32), transparent 62%),
      radial-gradient(120% 90% at 10% 100%, rgb(233 223 201 / 0.07), transparent 60%),
      linear-gradient(160deg, #14574f 0%, var(--color-pine) 55%, #082e2a 100%);
  }
  /* The parallax layer is 14% taller than the frame, so the content box is inset back to the frame's own edges */
  .panel__inner {
    position: absolute;
    inset: 6.1% 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.2rem;
    padding: 3.5rem 1.2rem 6.2rem;
  }
  .panel__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgb(250 248 242 / 0.5) 1px, transparent 1.4px);
    background-size: 22px 22px;
    opacity: 0.2;
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 75% 25%, #000 0%, transparent 100%);
    mask-image: radial-gradient(ellipse 80% 70% at 75% 25%, #000 0%, transparent 100%);
  }
  .panel__arcs {
    position: absolute;
    top: 0;
    right: 0;
    width: 78%;
    aspect-ratio: 1;
    color: rgb(233 223 201 / 0.2);
  }
  .panel__body {
    position: relative;
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .panel__eyebrow {
    display: none;
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(233 223 201 / 0.78);
  }
  .panel__line {
    margin: 0;
    max-width: 14ch;
    font: 400 clamp(1.7rem, 1.1rem + 2.6vw, 2.7rem) / 1.08 var(--font-serif);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .panel__line em {
    font-style: italic;
    color: var(--color-sand);
  }
  .panel__badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0;
    padding: 0.45rem 0.95rem 0.45rem 0.8rem;
    border: 1px solid rgb(250 248 242 / 0.22);
    border-radius: 999px;
    background: linear-gradient(135deg, rgb(250 248 242 / 0.14), rgb(250 248 242 / 0.05));
    font-size: 0.8125rem;
    color: rgb(250 248 242 / 0.86);
  }
  .panel__score {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .panel__score strong {
    font: 400 1.3rem/1 var(--font-serif);
    color: var(--color-ivory);
  }
  .panel__score :global(.panel__star) {
    fill: var(--color-sand);
    color: var(--color-sand);
    stroke-width: 1.5;
  }
  .panel__rule {
    width: 1px;
    height: 1.1rem;
    background: rgb(250 248 242 / 0.28);
  }

  /* ---- Floating rhythm (transform/opacity loops, paused whenever the hero is off screen) ---- */
  .hero__orbit {
    position: absolute;
    z-index: 0;
    width: 108%;
    aspect-ratio: 1;
    right: -8%;
    top: -7%;
    color: rgb(15 118 110 / 0.42);
    pointer-events: none;
    animation: orbit-turn 28s linear infinite;
  }
  .hero__orbit svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__marks {
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }
  /* a trio of dots, drifting ~8px */
  .hero__marks--a {
    left: -18px;
    top: 16%;
    width: 44px;
    height: 12px;
    background: radial-gradient(circle, rgb(15 118 110 / 0.55) 2px, transparent 2.6px) 0 50% / 14px 12px repeat-x;
    animation: mark-drift-a 9s ease-in-out infinite;
  }
  /* a short hairline, drifting ~10px */
  .hero__marks--b {
    right: -14px;
    bottom: 22%;
    width: 52px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(12 59 54 / 0.45));
    animation: mark-drift-b 11s ease-in-out infinite;
  }
  /* the photo's own shadow breathes: a soft pool under the frame swells and settles (the photograph itself never moves) */
  .hero__under {
    position: absolute;
    z-index: 0;
    left: 8%;
    right: 8%;
    bottom: 6px;
    height: 46px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(12 59 54 / 0.34), transparent);
    animation: breathe-under 9s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes orbit-turn {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes mark-drift-a {
    50% {
      transform: translate3d(6px, 8px, 0);
    }
  }
  @keyframes mark-drift-b {
    50% {
      transform: translate3d(-10px, -4px, 0);
    }
  }
  @keyframes breathe-under {
    50% {
      opacity: 0.55;
      transform: scaleX(0.93);
    }
  }

  .frame {
    position: relative;
    margin: 0;
    height: clamp(300px, 78vw, 380px);
    overflow: hidden;
    border-radius: 24px;
    background: var(--color-pine);
    box-shadow: 0 30px 50px -30px rgb(12 59 54 / 0.55);
    animation: appear 800ms ease-out 150ms both;
    isolation: isolate;
  }
  /* Parallax layer: taller than the frame so it can slide a little without exposing an edge */
  .frame__media {
    position: absolute;
    inset: -7% 0;
    transform: translate3d(0, var(--py, 0px), 0);
    will-change: transform;
  }
  .frame__scale {
    position: absolute;
    inset: 0;
    animation: settle-img 1200ms ease-out 150ms both;
  }
  @keyframes appear {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes settle-img {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }
  .frame__cap {
    position: absolute;
    z-index: 3;
    right: 12px;
    top: 12px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgb(12 59 54 / 0.72);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ivory);
  }

  /* Rises in, then floats on a gentle 6s loop (paused when off screen via .drift) */
  .hours-card {
    position: absolute;
    z-index: 4;
    left: 12px;
    bottom: 0;
    padding: 0.75rem 1rem 0.8rem;
    border-radius: 16px;
    line-height: 1.35;
    animation-name: rise, float-y;
    animation-duration: 700ms, 6s;
    animation-delay: var(--d), calc(var(--d) + 700ms);
    animation-iteration-count: 1, infinite;
    animation-timing-function: ease-out, ease-in-out;
    animation-fill-mode: both, none;
  }
  .hours-card p {
    margin: 0;
  }
  .hours-card__label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.3rem !important;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-teal);
  }
  .hours-card__main {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .hours-card__sub {
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
  }

  @media (min-width: 640px) {
    .panel__inner {
      padding: 1.3rem 1.4rem 6.2rem;
    }
    .panel__eyebrow {
      display: block;
    }
    .hero__cta {
      flex-direction: row;
      width: auto;
    }
    .hero__cta .btn {
      width: auto;
    }
    .frame {
      height: 400px;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding-top: calc(var(--header-h) + 20px);
    }
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 40px;
    }
    .hero__copy {
      grid-column: 1 / span 7;
    }
    .hero__title {
      max-width: 19ch;
    }
    .hero__visual {
      grid-column: 8 / span 5;
    }
    .frame {
      height: clamp(400px, 52vh, 470px);
      border-radius: 28px;
    }
    .hours-card {
      left: -48px;
      bottom: 6px;
      padding: 0.85rem 1.1rem 0.9rem;
    }
  }
</style>
