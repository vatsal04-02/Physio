---
import ClinicImage from './ClinicImage.astro';
import Placeholder from './Placeholder.astro';
import Icon from './Icon.astro';
import { clinic, hours, links } from '../data/site';
---

<section id="top" class="hero" data-section data-ambient aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <span class="orb" style="--s:560px; --c:rgb(15 118 110 / .16); right:-140px; top:-80px; --dur:40s"></span>
    <span class="orb" style="--s:440px; --c:rgb(233 223 201 / .95); left:-160px; bottom:-120px; --dur:46s"></span>
  </div>

  <div class="container-site hero__grid">
    <div class="hero__copy">
      <p class="eyebrow rise" style="--d:120ms">Local Physiotherapy • Gomti Nagar</p>

      <h1 id="hero-title" class="display hero__title">
        <span class="rise" style="--d:220ms">Move with <em class="accent-italic">less pain.</em></span>
        <span class="rise" style="--d:320ms">Get back to everyday life.</span>
      </h1>

      <p class="lead hero__lead rise" style="--d:420ms">
        Assessment-led physiotherapy in Lucknow, with clear guidance from Dr. Sandeep Tiwari and Dr. Mahesh Tiwari.
      </p>

      <div id="hero-cta" class="hero__cta rise" style="--d:520ms" data-hero-cta>
        <a class="btn btn-primary" href={links.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-location="hero">
          <Icon name="message-circle" size={20} />
          WhatsApp the Clinic
          <Icon name="arrow-right" size={18} class="icon-arrow" />
        </a>
        <a class="btn btn-outline" href={links.tel} data-track="phone_click" data-location="hero">
          <Icon name="phone" size={18} />
          Call the Clinic
        </a>
      </div>

      <div class="rating glass rise" style="--d:620ms">
        <span class="stars" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => <Icon name="star" size={15} class="star" />)}
        </span>
        <span class="rating__text">
          <strong>{clinic.rating.value}</strong> · {clinic.rating.count} Google reviews
        </span>
        <span class="sr-only">Rated {clinic.rating.value} out of 5 stars from {clinic.rating.count} Google reviews</span>
      </div>
    </div>

    <div class="hero__visual">
      <span class="hero__outline" aria-hidden="true"></span>
      <figure class="frame">
        <ClinicImage photo="hero" alt="Inside Geeta Krishna Physiotherapy, Gomti Nagar, Lucknow" sizes="(min-width:1024px) 560px, 100vw" priority>
          <Placeholder label="Clinic photograph" icon="camera" tone="pine" />
        </ClinicImage>
        <figcaption class="frame__cap">
          <Icon name="map-pin" size={13} /> Viram Khand, Gomti Nagar
        </figcaption>
      </figure>

      <div class="hours-card glass rise" style="--d:760ms">
        <p class="hours-card__label"><Icon name="clock" size={13} /> Clinic Hours</p>
        <p class="hours-card__main">{hours.days} · {hours.sessions[0]}</p>
        <p class="hours-card__sub">{hours.sessions[1]} · {hours.closed}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-top: calc(var(--header-h) + 12px);
    padding-bottom: clamp(44px, 5vw, 64px);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero__grid {
    position: relative;
    display: grid;
    gap: 36px;
    align-items: center;
  }

  /* ---- Copy ---- */
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .hero__title {
    margin-top: 0.9rem;
    color: var(--color-ink);
  }
  .hero__title > span {
    display: block;
  }
  .hero__lead {
    max-width: 32rem;
    margin-top: 1.1rem;
  }
  .hero__cta {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    width: 100%;
    margin-top: 1.6rem;
  }
  .hero__cta .btn {
    width: 100%;
  }

  .rating {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1.25rem;
    padding: 0.5rem 0.95rem 0.5rem 0.8rem;
    border-radius: 999px;
    font-size: 0.875rem;
  }
  .stars {
    display: inline-flex;
    gap: 2px;
    color: var(--star, #c8932a);
  }
  .stars :global(.star) {
    fill: currentColor;
    stroke-width: 1.5;
  }
  .rating strong {
    font: 400 1.1875rem/1 var(--font-serif);
  }

  /* ---- Photo-led visual ---- */
  .hero__visual {
    position: relative;
    padding: 0 0 26px 0;
  }
  /* Fine-line offset frame: controlled overlap, no heavy decoration */
  .hero__outline {
    position: absolute;
    inset: 14px -10px 12px 14px;
    border: 1px solid rgb(15 118 110 / 0.35);
    border-radius: 28px;
    pointer-events: none;
  }
  .frame {
    position: relative;
    margin: 0;
    height: clamp(300px, 78vw, 380px);
    overflow: hidden;
    border-radius: 24px;
    background: var(--color-pine);
    box-shadow: 0 30px 50px -30px rgb(12 59 54 / 0.55);
    animation: settle 900ms var(--ease-soft) both;
    animation-delay: 300ms;
    isolation: isolate;
  }
  .frame :global(.clinic-img) {
    animation: settle-img 1100ms var(--ease-soft) both;
    animation-delay: 300ms;
  }
  @keyframes settle-img {
    from {
      transform: scale(1.03);
    }
    to {
      transform: scale(1);
    }
  }
  .frame__cap {
    position: absolute;
    z-index: 3;
    right: 12px;
    top: 12px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgb(12 59 54 / 0.72);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ivory);
  }

  .hours-card {
    position: absolute;
    z-index: 4;
    left: 12px;
    bottom: 0;
    padding: 0.75rem 1rem 0.8rem;
    border-radius: 16px;
    line-height: 1.35;
  }
  .hours-card p {
    margin: 0;
  }
  .hours-card__label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.3rem !important;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-teal);
  }
  .hours-card__main {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .hours-card__sub {
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
  }

  @media (min-width: 640px) {
    .hero__cta {
      flex-direction: row;
      width: auto;
    }
    .hero__cta .btn {
      width: auto;
    }
    .frame {
      height: 400px;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding-top: calc(var(--header-h) + 20px);
    }
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 40px;
    }
    .hero__copy {
      grid-column: 1 / span 7;
    }
    .hero__visual {
      grid-column: 8 / span 5;
    }
    .frame {
      height: clamp(400px, 52vh, 470px);
      border-radius: 28px;
    }
    .hours-card {
      left: -48px;
      bottom: 6px;
      padding: 0.85rem 1.1rem 0.9rem;
    }
  }
</style>
