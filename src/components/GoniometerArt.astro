---
/**
 * Decorative motion graphic: a goniometer-style dial (the instrument used to measure joint
 * range of movement) with a limb that sweeps through its range. Pure SVG + CSS transforms —
 * no JS, no raster — and it only fills a slot until real clinic photography is supplied.
 */
const PX = 200;
const PY = 300;
const R = 150;

const ticks = Array.from({ length: 60 }, (_, i) => {
  const a = (i * 6 * Math.PI) / 180;
  const major = i % 5 === 0;
  const len = major ? 15 : 7;
  return {
    i,
    major,
    x1: +(PX + Math.cos(a) * R).toFixed(2),
    y1: +(PY + Math.sin(a) * R).toFixed(2),
    x2: +(PX + Math.cos(a) * (R - len)).toFixed(2),
    y2: +(PY + Math.sin(a) * (R - len)).toFixed(2),
  };
});

// Sweep of the moving limb: 0° → −70° (counter-clockwise on screen).
const sweepDeg = 70;
const arcR = 96;
const rad = (sweepDeg * Math.PI) / 180;
const arcEnd = { x: +(PX + Math.cos(rad) * arcR).toFixed(2), y: +(PY - Math.sin(rad) * arcR).toFixed(2) };
const fanR = 48; // stroke-width 96 around r=48 fills a sector from 0 → 96
const fanEnd = { x: +(PX + Math.cos(rad) * fanR).toFixed(2), y: +(PY - Math.sin(rad) * fanR).toFixed(2) };
---

<svg
  class="goni"
  viewBox="0 0 400 500"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <radialGradient id="goni-glow" cx="50%" cy="60%" r="55%">
      <stop offset="0" stop-color="#0F766E" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#0C3B36" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="goni-arm" gradientUnits="userSpaceOnUse" x1="200" y1="0" x2="378" y2="0">
      <stop offset="0" stop-color="#E9DFC9" stop-opacity="0.35"></stop>
      <stop offset="1" stop-color="#FAF8F2"></stop>
    </linearGradient>
  </defs>

  <rect width="400" height="500" fill="url(#goni-glow)"></rect>

  <!-- Outer + inner rings -->
  <g class="spin spin--slow drift" style={`transform-origin:${PX}px ${PY}px`}>
    <circle cx={PX} cy={PY} r="196" fill="none" stroke="#E9DFC9" stroke-opacity="0.16" stroke-width="1" stroke-dasharray="2 9"></circle>
  </g>
  <g class="spin spin--rev drift" style={`transform-origin:${PX}px ${PY}px`}>
    <circle cx={PX} cy={PY} r="118" fill="none" stroke="#E9DFC9" stroke-opacity="0.22" stroke-width="1" stroke-dasharray="1 6"></circle>
  </g>
  <circle cx={PX} cy={PY} r="70" fill="none" stroke="#E9DFC9" stroke-opacity="0.12" stroke-width="1"></circle>

  <!-- Dial ring draws in, then ticks stagger -->
  <circle class="dial" cx={PX} cy={PY} r={R} fill="none" stroke="#E9DFC9" stroke-opacity="0.55" stroke-width="1.25" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1"></circle>
  <g stroke="#E9DFC9" stroke-linecap="round">
    {
      ticks.map((t) => (
        <line
          class="tick"
          style={`--i:${t.i}`}
          x1={t.x1}
          y1={t.y1}
          x2={t.x2}
          y2={t.y2}
          stroke-width={t.major ? 1.6 : 1}
          stroke-opacity={t.major ? 0.7 : 0.35}
        />
      ))
    }
  </g>

  <!-- Range-of-motion sector + arc, synced to the limb -->
  <path
    class="fan drift"
    d={`M ${PX + fanR} ${PY} A ${fanR} ${fanR} 0 0 0 ${fanEnd.x} ${fanEnd.y}`}
    fill="none"
    stroke="#2f9c92"
    stroke-opacity="0.26"
    stroke-width="96"
    pathLength="100"
    stroke-dasharray="100"
    stroke-dashoffset="100"></path>
  <path
    class="arc drift"
    d={`M ${PX + arcR} ${PY} A ${arcR} ${arcR} 0 0 0 ${arcEnd.x} ${arcEnd.y}`}
    fill="none"
    stroke="#E9DFC9"
    stroke-width="2.25"
    stroke-linecap="round"
    pathLength="100"
    stroke-dasharray="100"
    stroke-dashoffset="100"></path>

  <!-- Fixed limb -->
  <g class="limb limb--fixed">
    <line x1={PX} y1={PY} x2={PX + 178} y2={PY} stroke="url(#goni-arm)" stroke-width="4" stroke-linecap="round"></line>
    <circle cx={PX + 178} cy={PY} r="6" fill="#FAF8F2"></circle>
  </g>

  <!-- Moving limb -->
  <g class="limb limb--move drift" style={`transform-origin:${PX}px ${PY}px`}>
    <line x1={PX} y1={PY} x2={PX + 178} y2={PY} stroke="url(#goni-arm)" stroke-width="4" stroke-linecap="round"></line>
    <circle class="pulse" cx={PX + 178} cy={PY} r="14" fill="none" stroke="#E9DFC9" stroke-opacity="0.5" stroke-width="1"></circle>
    <circle cx={PX + 178} cy={PY} r="6" fill="#FAF8F2"></circle>
  </g>

  <!-- Pivot -->
  <circle cx={PX} cy={PY} r="17" fill="#0C3B36" stroke="#E9DFC9" stroke-opacity="0.7" stroke-width="1.5"></circle>
  <circle cx={PX} cy={PY} r="6.5" fill="#E9DFC9"></circle>

  <text x={PX} y="462" text-anchor="middle" class="caption">RANGE OF MOTION</text>
</svg>

<style>
  .goni {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .caption {
    font: 700 10px/1 var(--font-sans);
    letter-spacing: 0.34em;
    fill: #e9dfc9;
    fill-opacity: 0.55;
  }

  /* Intro (runs once) */
  .dial {
    animation: draw 1.5s var(--ease-inout) 200ms forwards;
  }
  .tick {
    opacity: 0;
    animation: tick-in 500ms ease forwards;
    animation-delay: calc(450ms + var(--i) * 12ms);
  }

  /* Ambient loops */
  .spin {
    animation: spin-slow 120s linear infinite;
  }
  .spin--rev {
    animation-duration: 160s;
    animation-direction: reverse;
  }
  .limb--move {
    animation: swing 11s var(--ease-inout) 1.4s infinite;
  }
  .fan,
  .arc {
    animation: sweep 11s var(--ease-inout) 1.4s infinite;
  }
  .pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: ping 2.6s ease-out infinite;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes tick-in {
    to {
      opacity: 1;
    }
  }
  @keyframes swing {
    0%,
    8% {
      transform: rotate(0deg);
    }
    46%,
    58% {
      transform: rotate(-70deg);
    }
    96%,
    100% {
      transform: rotate(0deg);
    }
  }
  @keyframes sweep {
    0%,
    8% {
      stroke-dashoffset: 100;
    }
    46%,
    58% {
      stroke-dashoffset: 0;
    }
    96%,
    100% {
      stroke-dashoffset: 100;
    }
  }
  @keyframes ping {
    0% {
      transform: scale(0.7);
      opacity: 0.8;
    }
    70%,
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  /* Reduced motion: hold a resting pose instead of looping */
  @media (prefers-reduced-motion: reduce) {
    .dial {
      stroke-dashoffset: 0;
      animation: none;
    }
    .tick {
      opacity: 1;
      animation: none;
    }
    .limb--move {
      animation: none;
      transform: rotate(-42deg);
    }
    .fan,
    .arc {
      animation: none;
      stroke-dashoffset: 40;
    }
    .pulse {
      display: none;
    }
  }
</style>
