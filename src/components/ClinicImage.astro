---
import { Picture } from 'astro:assets';
import { getPhoto } from '../lib/photos';

interface Props {
  slot: string;
  alt: string;
  sizes?: string;
  /** Above-the-fold image: eager, high priority. */
  priority?: boolean;
  class?: string;
}

const { slot, alt, sizes = '100vw', priority = false, class: className } = Astro.props;
const photo = getPhoto(slot);
---

{
  photo ? (
    <Picture
      src={photo}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[480, 768, 1100, 1600]}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
      class:list={['clinic-img', className]}
    />
  ) : (
    <slot />
  )
}

<style is:global>
  .clinic-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
