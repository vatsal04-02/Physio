---
import Icon from './Icon.astro';
import { concernMessage, conditions, whatsappLink, links } from '../data/site';
---

<section id="conditions" class="section surface-ivory" data-section data-ambient aria-labelledby="conditions-title">
  <div class="bg" aria-hidden="true">
    <span class="orb" style="--s:560px; --c:rgb(15 118 110 / .16); right:-140px; top:6%; --dur:36s"></span>
    <span class="orb" style="--s:480px; --c:rgb(233 223 201 / 1); left:-160px; bottom:4%; --dur:42s"></span>
  </div>

  <div class="container-site relative">
    <header class="head reveal">
      <p class="eyebrow">Conditions &amp; services</p>
      <h2 id="conditions-title" class="h2">Start with what you’re feeling.</h2>
      <p class="lead">
        Choose the concern closest to yours. The clinic will assess your individual condition before recommending care.
      </p>
    </header>

    <ul class="grid">
      {
        conditions.map((c, i) => (
          <li class:list={['cell reveal', { 'cell--featured': c.featured }]} style={`--i:${Math.min(i, 8) % 4}`}>
            <a
              class:list={['card spot', { 'card--featured': c.featured }]}
              href={whatsappLink(concernMessage(c.ask))}
              target="_blank"
              rel="noopener noreferrer"
              data-track="condition_click"
              data-location="conditions"
              data-concern={c.title}
            >
              {c.featured && (
                <>
                  <svg class="card__rings" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
                    <g fill="none" stroke="#0C3B36" stroke-opacity=".12">
                      <circle cx="100" cy="100" r="46"></circle>
                      <circle cx="100" cy="100" r="74" stroke-dasharray="2 7"></circle>
                      <circle cx="100" cy="100" r="98"></circle>
                    </g>
                  </svg>
                  <Icon name={c.icon} size={150} strokeWidth={1} class="card__ghost" />
                </>
              )}
              <span class="card__top">
                <span class="card__icon">
                  <Icon name={c.icon} size={c.featured ? 24 : 20} />
                </span>
                <Icon name="arrow-up-right" size={20} class="card__arrow" />
              </span>
              <span class="card__body">
                <span class="card__title">{c.title}</span>
                <span class="card__blurb">{c.blurb}</span>
              </span>
              <span class="sr-only"> — message the clinic on WhatsApp about this concern (opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="more reveal">
      <a class="link-arrow" href={links.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-location="conditions-footer">
        Not sure where to start? WhatsApp the clinic
        <Icon name="arrow-right" size={18} />
      </a>
    </p>
  </div>
</section>

<style>
  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .relative {
    position: relative;
  }
  .head {
    display: grid;
    gap: 1.1rem;
    max-width: 44rem;
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cell {
    display: flex;
  }
  .cell--featured {
    grid-column: 1 / -1;
  }

  .card {
    --mx: 50%;
    --my: 0%;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    width: 100%;
    min-height: 148px;
    padding: 1rem 1rem 1.05rem;
    border-radius: 20px;
    border: 1px solid rgb(12 59 54 / 0.1);
    background: linear-gradient(145deg, rgb(255 255 255 / 0.78), rgb(250 248 242 / 0.62));
    color: var(--color-ink);
    text-decoration: none;
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.8) inset, 0 8px 20px -16px rgb(12 59 54 / 0.35);
    overflow: hidden;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform var(--dur-normal) var(--ease-soft),
      border-color var(--dur-normal) ease,
      box-shadow var(--dur-normal) ease;
  }
  /* Cursor-tracked highlight — pointer devices only */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    background: radial-gradient(240px circle at var(--mx) var(--my), rgb(15 118 110 / 0.16), transparent 70%);
    transition: opacity var(--dur-normal) ease;
  }
  .card:hover,
  .card:focus-visible {
    transform: translateY(-3px);
    border-color: rgb(15 118 110 / 0.45);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.8) inset, 0 18px 30px -18px rgb(12 59 54 / 0.45);
  }
  .card:hover::before {
    opacity: 1;
  }
  .card:active {
    transform: translateY(-1px) scale(0.99);
  }
  .card__rings {
    position: absolute;
    z-index: -1;
    right: -48px;
    bottom: -48px;
    width: 240px;
    pointer-events: none;
  }
  .card :global(.card__ghost) {
    position: absolute;
    z-index: -1;
    right: 22px;
    bottom: 18px;
    color: rgb(12 59 54 / 0.09);
    pointer-events: none;
  }
  .card--featured {
    min-height: 170px;
    background: linear-gradient(145deg, rgb(233 223 201 / 0.95), rgb(233 223 201 / 0.7));
    border-color: rgb(12 59 54 / 0.14);
  }

  .card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }
  .card__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: rgb(15 118 110 / 0.1);
    color: var(--color-teal);
    transition:
      background-color var(--dur-normal) ease,
      color var(--dur-normal) ease;
  }
  .card:hover .card__icon {
    background: var(--color-teal);
    color: #fff;
  }
  .card--featured .card__icon {
    width: 48px;
    height: 48px;
    background: rgb(12 59 54 / 0.9);
    color: var(--color-sand);
  }
  .card :global(.card__arrow) {
    color: rgb(12 59 54 / 0.4);
    transition:
      transform var(--dur-normal) var(--ease-soft),
      color var(--dur-normal) ease;
  }
  .card:hover :global(.card__arrow) {
    color: var(--color-teal);
    transform: translate(3px, -3px);
  }

  .card__body {
    display: grid;
    gap: 0.3rem;
  }
  .card__title {
    font: 400 1.1875rem/1.2 var(--font-serif);
    letter-spacing: -0.005em;
    text-wrap: balance;
  }
  .card--featured .card__title {
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2rem);
  }
  .card__blurb {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-ink) 68%, transparent);
  }

  .more {
    display: flex;
    justify-content: center;
    margin-top: clamp(32px, 4vw, 48px);
    font-size: 1.0625rem;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
    .cell--featured {
      grid-column: span 3;
    }
    .card {
      min-height: 168px;
      padding: 1.25rem;
    }
    .card__title {
      font-size: 1.3125rem;
    }
    .card__blurb {
      font-size: 0.875rem;
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
    }
    .cell--featured {
      grid-column: span 2;
      grid-row: span 2;
    }
    .card--featured {
      min-height: 100%;
      padding: 1.75rem;
    }
    .card--featured .card__blurb {
      font-size: 1rem;
      -webkit-line-clamp: 3;
    }
  }

  @media (hover: none) {
    .card:hover {
      transform: none;
    }
  }
</style>
