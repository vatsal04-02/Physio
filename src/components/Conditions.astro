---
import Icon from './Icon.astro';
import { concernMessage, conditions, whatsappLink, links } from '../data/site';
---

<section id="conditions" class="section surface-ivory" data-section data-ambient aria-labelledby="conditions-title">
  <div class="bg" aria-hidden="true">
    <span class="orb" style="--s:520px; --c:rgb(15 118 110 / .12); right:-160px; top:0; --dur:42s"></span>
  </div>

  <div class="container-site relative">
    <header class="head reveal">
      <div class="head__title">
        <p class="eyebrow">01 / Conditions</p>
        <h2 id="conditions-title" class="h2">Start with what you’re feeling.</h2>
      </div>
      <p class="lead head__lead">
        Choose the concern closest to yours. The clinic will assess your individual condition before recommending care.
      </p>
    </header>

    <ul class="grid">
      {
        conditions.map((c, i) => (
          <li class:list={['cell reveal', { 'cell--wide-sm': c.title === 'Consultation' }]} style={`--i:${i % 4}`}>
            <a
              class="card spot"
              href={whatsappLink(concernMessage(c.ask))}
              target="_blank"
              rel="noopener noreferrer"
              data-track="condition_click"
              data-location="conditions"
              data-concern={c.title}
            >
              <span class="card__top">
                <span class="card__icon">
                  <Icon name={c.icon} size={19} />
                </span>
                <Icon name="arrow-up-right" size={18} class="card__arrow" />
              </span>
              <span class="card__body">
                <span class="card__title">{c.title}</span>
                <span class="card__blurb">{c.blurb}</span>
              </span>
              <span class="sr-only"> — message the clinic on WhatsApp about this concern (opens in a new tab)</span>
            </a>
          </li>
        ))
      }

      <li class="cell cell--cta reveal" style="--i:1">
        <div class="cta">
          <div>
            <p class="cta__title">Not sure where to start?</p>
            <p class="cta__sub">Tell the clinic what you’re experiencing — they’ll point you to the next step.</p>
          </div>
          <a class="btn btn-primary btn-sm" href={links.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-location="conditions-cta">
            WhatsApp the clinic
            <Icon name="arrow-right" size={18} class="icon-arrow" />
          </a>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .relative {
    position: relative;
  }
  .head {
    display: grid;
    gap: 0.9rem;
    margin-bottom: clamp(24px, 3.5vw, 40px);
  }
  .head__title {
    display: grid;
    gap: 0.8rem;
  }
  .head__lead {
    max-width: 34rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cell {
    display: flex;
  }
  .cell--wide-sm {
    grid-column: 1 / -1;
  }
  .cell--cta {
    grid-column: 1 / -1;
  }

  .card {
    --mx: 50%;
    --my: 0%;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.85rem;
    width: 100%;
    min-height: 116px;
    padding: 0.85rem 0.9rem 0.9rem;
    border-radius: 16px;
    border: 1px solid rgb(12 59 54 / 0.1);
    background: linear-gradient(145deg, rgb(255 255 255 / 0.82), rgb(250 248 242 / 0.66));
    color: var(--color-ink);
    text-decoration: none;
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.8) inset, 0 6px 16px -14px rgb(12 59 54 / 0.4);
    overflow: hidden;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform var(--dur-normal) var(--ease-soft),
      border-color var(--dur-normal) ease,
      box-shadow var(--dur-normal) ease;
  }
  /* Cursor-tracked highlight — pointer devices only */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    background: radial-gradient(220px circle at var(--mx) var(--my), rgb(15 118 110 / 0.14), transparent 70%);
    transition: opacity var(--dur-normal) ease;
  }
  .card:hover,
  .card:focus-visible {
    transform: translateY(-3px);
    border-color: rgb(15 118 110 / 0.45);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.8) inset, 0 16px 26px -18px rgb(12 59 54 / 0.45);
  }
  .card:hover::before {
    opacity: 1;
  }
  .card:active {
    transform: translateY(-1px) scale(0.99);
  }

  .card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }
  .card__icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: rgb(15 118 110 / 0.1);
    color: var(--color-teal);
    transition:
      background-color var(--dur-normal) ease,
      color var(--dur-normal) ease;
  }
  .card:hover .card__icon {
    background: var(--color-teal);
    color: #fff;
  }
  .card :global(.card__arrow) {
    color: rgb(12 59 54 / 0.4);
    transition:
      transform var(--dur-normal) var(--ease-soft),
      color var(--dur-normal) ease;
  }
  .card:hover :global(.card__arrow) {
    color: var(--color-teal);
    transform: translate(3px, -3px);
  }

  .card__body {
    display: grid;
    gap: 0.2rem;
  }
  .card__title {
    font: 400 1.0625rem/1.2 var(--font-serif);
    text-wrap: balance;
  }
  .card__blurb {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-ink) 68%, transparent);
  }

  /* Micro-CTA tile (warm sand) closes the grid */
  .cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 1.1rem 1.1rem 1.15rem;
    border-radius: 16px;
    background: linear-gradient(135deg, #efe6d2, var(--color-sand));
    border: 1px solid rgb(12 59 54 / 0.1);
  }
  .cta__title {
    font: 400 1.3125rem/1.2 var(--font-serif);
    color: var(--color-pine);
  }
  .cta__sub {
    margin-top: 0.3rem;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }
    .cell--wide-sm {
      grid-column: auto;
    }
    .cell--cta {
      grid-column: span 2;
    }
    .card {
      min-height: 124px;
      padding: 1rem;
    }
    .cta {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
      gap: 32px;
    }
    .head__title {
      grid-column: 1 / span 6;
    }
    .head__lead {
      grid-column: 8 / span 5;
      padding-bottom: 0.3rem;
    }
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
    }
    .cell--cta {
      grid-column: span 3;
    }
    .card__title {
      font-size: 1.125rem;
    }
  }

  @media (hover: none) {
    .card:hover {
      transform: none;
    }
  }
</style>
