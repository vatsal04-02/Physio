---
import Icon from './Icon.astro';
import { TBD, links, pricing } from '../data/site';

const confirmed = pricing.confirmedAmount;
---

<section id="pricing" class="section curve surface-ivory" data-section aria-labelledby="pricing-title">
  <div class="container-site grid">
    <header class="copy reveal">
      <p class="eyebrow">08 / Pricing</p>
      <h2 id="pricing-title" class="h2">No surprise bills. Ever.</h2>
      <p class="lead">
        The starting rate for a physiotherapy session. If you have a question about anything not listed here, just ask the clinic.
      </p>
    </header>

    <article class="card reveal" style="--i:1" aria-labelledby="price-label">
      <div class="card__main">
        <p id="price-label" class="card__label">{pricing.label}</p>
        <p class="card__from">Starting from</p>

        {
          confirmed ? (
            <p class="card__amount">{confirmed}</p>
          ) : (
            <p class="card__amount card__amount--ph" data-placeholder>
              <span class="rupee" aria-hidden="true">₹</span>
              <span class="xs" aria-hidden="true">XXXX</span>
              <span class="tbd">{TBD}</span>
            </p>
          )
        }
        <p class="card__unit">{pricing.unit}</p>

        <a class="btn btn-primary" href={links.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-location="pricing">
          <Icon name="message-circle" size={20} />
          WhatsApp the Clinic
          <Icon name="arrow-right" size={18} class="icon-arrow" />
        </a>
      </div>

      <dl class="extras">
        {
          pricing.extras.map((e) => (
            <div>
              <dt>{e.label}</dt>
              <dd>{e.value === TBD ? <span class="tbd">{e.value}</span> : e.value}</dd>
            </div>
          ))
        }
      </dl>
    </article>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: clamp(24px, 4vw, 44px);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 0.9rem;
    max-width: 28rem;
  }

  .card {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border-radius: 24px;
    overflow: hidden;
    background: linear-gradient(150deg, #efe6d2, var(--color-sand) 60%, #ddd0b3);
    box-shadow:
      0 30px 46px -34px rgb(12 59 54 / 0.45),
      inset 0 0 0 1px rgb(255 255 255 / 0.45);
  }
  .card__main {
    display: grid;
    justify-items: start;
    gap: 0.3rem;
  }
  .card__label {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-teal);
  }
  .card__from {
    margin-top: 0.8rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-ink) 62%, transparent);
  }
  .card__amount {
    font: 400 clamp(2.75rem, 2.2rem + 2.4vw, 4rem) / 1.05 var(--font-serif);
    color: var(--color-pine);
  }
  /* Controlled internal placeholder — reads as "pending", not as a real price */
  .card__amount--ph {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.3rem 0.6rem;
  }
  .card__amount--ph .xs {
    color: transparent;
    -webkit-text-stroke: 1px rgb(12 59 54 / 0.45);
    letter-spacing: 0.04em;
  }
  .card__amount--ph .tbd {
    margin-left: 0.4rem;
    color: var(--color-pine);
  }
  .card__unit {
    margin-bottom: 0.9rem;
    color: color-mix(in srgb, var(--color-ink) 74%, transparent);
  }

  .extras {
    display: grid;
    margin: 0;
    padding: 0.2rem 1rem;
    border-radius: 16px;
    background: rgb(250 248 242 / 0.6);
    border: 1px solid rgb(255 255 255 / 0.7);
    align-self: end;
  }
  .extras div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    padding: 0.8rem 0;
  }
  .extras div + div {
    border-top: 1px solid rgb(12 59 54 / 0.12);
  }
  .extras dt {
    font-weight: 700;
  }
  .extras dd {
    margin: 0;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 32px;
    }
    .copy {
      grid-column: 1 / span 5;
    }
    .card {
      grid-column: 6 / span 7;
      grid-template-columns: 1.2fr 1fr;
      gap: 1.75rem;
    }
  }
</style>
