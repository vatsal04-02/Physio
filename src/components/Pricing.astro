---
import Icon from './Icon.astro';
import { TBD, links, pricing } from '../data/site';
---

<section id="pricing" class="section surface-ivory" data-section data-ambient aria-labelledby="pricing-title">
  <div class="bg" aria-hidden="true">
    <span class="orb" style="--s:520px; --c:rgb(15 118 110 / .14); left:-140px; top:-40px; --dur:38s"></span>
  </div>

  <div class="container-site grid">
    <header class="copy reveal">
      <p class="eyebrow">Pricing</p>
      <h2 id="pricing-title" class="h2">Simple, clear pricing.</h2>
      <p class="lead">
        The starting rate for a physiotherapy session. If you have a question about anything not listed here, just ask the clinic.
      </p>
    </header>

    <article class="card reveal" style="--i:1" aria-labelledby="price-label">
      <svg class="card__rings drift" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
        <g fill="none" stroke="#0C3B36" stroke-opacity=".1">
          <circle cx="200" cy="200" r="90"></circle>
          <circle cx="200" cy="200" r="150" stroke-dasharray="2 8"></circle>
          <circle cx="200" cy="200" r="196"></circle>
        </g>
      </svg>

      <div class="card__main">
        <p id="price-label" class="card__label">{pricing.label}</p>
        <p class="card__from">Starting from</p>
        <p class="card__amount">
          <span class="rupee" aria-hidden="true">₹</span>
          <span class="tbd">{TBD}</span>
        </p>
        <p class="card__unit">{pricing.unit}</p>

        <a class="btn btn-primary" href={links.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-location="pricing">
          <Icon name="message-circle" size={20} />
          WhatsApp the Clinic
          <Icon name="arrow-right" size={18} class="icon-arrow" />
        </a>
      </div>

      <dl class="extras glass">
        {
          pricing.extras.map((e) => (
            <div>
              <dt>{e.label}</dt>
              <dd><span class="tbd">{e.value}</span></dd>
            </div>
          ))
        }
      </dl>
    </article>
  </div>
</section>

<style>
  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .grid {
    position: relative;
    display: grid;
    gap: clamp(32px, 5vw, 56px);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 1.1rem;
    max-width: 30rem;
  }

  .card {
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    border-radius: 32px;
    overflow: hidden;
    background: linear-gradient(150deg, #efe6d2, var(--color-sand) 55%, #ddd0b3);
    box-shadow:
      0 40px 60px -40px rgb(12 59 54 / 0.45),
      inset 0 0 0 1px rgb(255 255 255 / 0.45);
  }
  .card__rings {
    position: absolute;
    right: -120px;
    top: -120px;
    width: 440px;
    animation: spin-slow 160s linear infinite;
    pointer-events: none;
  }
  .card__main {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 0.35rem;
  }
  .card__label {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-teal);
  }
  .card__from {
    margin-top: 1.1rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-ink) 62%, transparent);
  }
  .card__amount {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem 0.9rem;
    color: var(--color-pine);
  }
  .rupee {
    font: 400 clamp(4rem, 3rem + 5vw, 6.5rem) / 1 var(--font-serif);
  }
  .card__unit {
    margin-bottom: 1.2rem;
    font-size: 1.0625rem;
    color: color-mix(in srgb, var(--color-ink) 74%, transparent);
  }

  .extras {
    position: relative;
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0.35rem 1.25rem;
    border-radius: 20px;
  }
  .extras div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.9rem 0;
  }
  .extras div + div {
    border-top: 1px solid rgb(12 59 54 / 0.12);
  }
  .extras dt {
    font-weight: 700;
  }
  .extras dd {
    margin: 0;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 32px;
    }
    .copy {
      grid-column: 1 / span 4;
    }
    .card {
      grid-column: 6 / span 7;
      grid-template-columns: 1.15fr 1fr;
      align-items: end;
      gap: 2rem;
    }
  }
</style>
