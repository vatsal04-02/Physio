---
import Icon from './Icon.astro';
import { principles } from '../data/site';
---

<section id="why" class="section surface-pine on-dark" data-section data-ambient aria-labelledby="why-title">
  <div class="bg" aria-hidden="true">
    <span class="orb" style="--s:560px; --c:rgb(15 118 110 / .5); right:-180px; top:-140px; --dur:44s"></span>
    <div class="dots"></div>
  </div>

  <div class="container-site relative">
    <header class="head reveal">
      <div class="head__title">
        <p class="eyebrow">02 / Why this approach</p>
        <h2 id="why-title" class="h2">Physiotherapy that starts with understanding.</h2>
      </div>
      <a class="link-arrow head__link" href="#doctors">
        Meet the clinic leads
        <Icon name="arrow-right" size={18} />
      </a>
    </header>

    <ol class="items">
      {
        principles.map((p, i) => (
          <li class="item reveal" style={`--i:${i}`}>
            <span class="item__ghost" aria-hidden="true">{p.n}</span>
            <span class="item__n">{p.n}</span>
            <h3 class="item__title">{p.title}</h3>
            <p class="item__body">{p.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .relative {
    position: relative;
  }
  .head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .head__title {
    display: grid;
    gap: 0.8rem;
    max-width: 36rem;
  }

  .items {
    display: grid;
    gap: 0 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .item {
    position: relative;
    overflow: hidden;
    padding: 1.1rem 0 1.4rem;
    border-top: 1px solid rgb(250 248 242 / 0.18);
  }
  /* Oversized background numerals — subtle, never competing with the text */
  .item__ghost {
    position: absolute;
    right: -0.15rem;
    top: 0.1rem;
    font: 400 5.5rem/1 var(--font-serif);
    color: rgb(250 248 242 / 0.06);
    pointer-events: none;
    user-select: none;
  }
  .item__n {
    position: relative;
    font: 400 1.25rem/1 var(--font-serif);
    color: var(--color-sand);
  }
  .item__title {
    position: relative;
    margin-top: 0.85rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ivory);
  }
  .item__body {
    position: relative;
    margin-top: 0.5rem;
    max-width: 17rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(250 248 242 / 0.74);
  }

  @media (min-width: 600px) {
    .items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .items {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0 32px;
    }
    .item {
      padding-bottom: 0.4rem;
    }
  }
</style>
