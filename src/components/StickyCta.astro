---
import Icon from './Icon.astro';
import { links } from '../data/site';
---

<!-- Mobile: fixed bottom bar. Desktop: floating round button (design.md §22). Appears once the hero CTA has scrolled away. -->
<div class="sticky-cta" data-sticky-cta>
  <div class="bar glass">
    <a class="call" href={links.tel} aria-label="Call the Clinic" data-track="phone_click" data-location="sticky">
      <Icon name="phone" size={20} />
    </a>
    <a class="wa btn btn-primary" href={links.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-location="sticky">
      WhatsApp the Clinic
      <Icon name="arrow-right" size={18} class="icon-arrow" />
    </a>
  </div>

  <a class="fab" href={links.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp the Clinic" data-track="whatsapp_click" data-location="floating">
    <Icon name="message-circle" size={26} />
    <span class="fab__label" aria-hidden="true">WhatsApp the Clinic</span>
  </a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    z-index: 40;
    inset: auto 0 0 0;
    padding: 0 12px calc(env(safe-area-inset-bottom, 0px) + 12px);
    pointer-events: none;
    transition:
      transform 420ms var(--ease-soft),
      opacity 320ms ease;
  }
  /* Hidden only when JS can reveal it again */
  :global(.js) .sticky-cta:not(.is-visible) {
    transform: translate3d(0, 130%, 0);
    opacity: 0;
  }
  .sticky-cta > * {
    pointer-events: auto;
  }

  .bar {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    padding: 0.5rem;
    border-radius: 18px;
    background: linear-gradient(135deg, rgb(250 248 242 / 0.86), rgb(250 248 242 / 0.66));
    max-width: 560px;
    margin-inline: auto;
  }
  .call {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    border: 1.5px solid var(--color-teal);
    color: var(--color-teal);
    background: rgb(255 255 255 / 0.5);
    transition: transform var(--dur-fast) var(--ease-soft);
  }
  .call:active {
    transform: scale(0.95);
  }
  .wa {
    width: 100%;
    min-width: 0;
    min-height: 52px;
    padding-inline: 0.75rem;
    gap: 0.5rem;
  }
  @media (max-width: 349px) {
    .wa :global(.icon-arrow) {
      display: none;
    }
  }

  .fab {
    display: none;
  }

  @media (min-width: 900px) {
    .sticky-cta {
      inset: auto 28px 28px auto;
      padding: 0;
    }
    :global(.js) .sticky-cta:not(.is-visible) {
      transform: translate3d(0, 24px, 0) scale(0.9);
    }
    .bar {
      display: none;
    }
    .fab {
      position: relative;
      display: grid;
      place-items: center;
      width: 62px;
      height: 62px;
      border-radius: 50%;
      background: var(--color-cta);
      color: #fff;
      text-decoration: none;
      box-shadow:
        0 18px 30px -12px rgb(234 88 12 / 0.75),
        inset 0 1px 0 rgb(255 255 255 / 0.3);
      transition:
        transform var(--dur-normal) var(--ease-soft),
        background-color var(--dur-normal) ease;
    }
    .fab:hover {
      transform: translateY(-3px);
      background: #d94e09;
    }
    .fab:active {
      transform: scale(0.96);
    }
    .fab__label {
      position: absolute;
      right: calc(100% + 12px);
      top: 50%;
      padding: 0.5rem 0.9rem;
      border-radius: 10px;
      background: var(--color-pine);
      color: var(--color-ivory);
      font-size: 0.875rem;
      font-weight: 700;
      white-space: nowrap;
      opacity: 0;
      transform: translate3d(8px, -50%, 0);
      pointer-events: none;
      transition:
        opacity var(--dur-normal) ease,
        transform var(--dur-normal) var(--ease-soft);
    }
    .fab:hover .fab__label,
    .fab:focus-visible .fab__label {
      opacity: 1;
      transform: translate3d(0, -50%, 0);
    }
  }
</style>
