---
import Icon from './Icon.astro';
import { whatWeDo } from '../data/site';
---

<section id="what-we-do" class="section-tight surface-ivory block" data-section aria-labelledby="wwd-title">
  <div class="container-site">
    <header class="head reveal">
      <p class="eyebrow">05 / What we do</p>
      <h2 id="wwd-title" class="h2">Support for pain, movement and recovery.</h2>
    </header>

    <ul class="cols">
      {
        whatWeDo.map((w, i) => (
          <li class="col reveal" style={`--i:${i}`}>
            <span class="col__icon"><Icon name={w.icon} size={20} /></span>
            <h3 class="col__title">{w.title}</h3>
            <p class="col__body">{w.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .block {
    position: relative;
    overflow: clip;
  }
  .head {
    display: grid;
    gap: 0.8rem;
    max-width: 34rem;
    margin-bottom: clamp(24px, 3.5vw, 36px);
  }
  .cols {
    display: grid;
    gap: 0 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .col {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1rem;
    row-gap: 0.25rem;
    align-items: start;
    padding-block: 1.1rem;
    border-top: 1px solid rgb(12 59 54 / 0.16);
  }
  .col__icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: rgb(15 118 110 / 0.1);
    color: var(--color-teal);
  }
  .col__title {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-pine);
    padding-top: 0.15rem;
  }
  .col__body {
    font-size: 0.9688rem;
    color: color-mix(in srgb, var(--color-ink) 76%, transparent);
  }

  @media (min-width: 768px) {
    .cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .col {
      grid-template-columns: 1fr;
      row-gap: 0.6rem;
      padding-top: 1.4rem;
    }
    .col__icon {
      grid-row: auto;
    }
    .col__body {
      max-width: 19rem;
    }
  }
</style>
