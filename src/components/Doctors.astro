---
import ClinicImage from './ClinicImage.astro';
import Placeholder from './Placeholder.astro';
import Icon from './Icon.astro';
import { doctorMessage, doctors, whatsappLink } from '../data/site';
---

<section id="doctors" class="section curve surface-ivory" data-section data-ambient aria-labelledby="doctors-title">
  <div class="bg" aria-hidden="true">
    <span class="orb" style="--s:520px; --c:rgb(233 223 201 / 1); left:-180px; top:8%; --dur:44s"></span>
  </div>

  <div class="container-site relative">
    <div class="layout">
    <header class="head reveal">
      <p class="eyebrow">03 / Doctors</p>
      <h2 id="doctors-title" class="h2">You’ll know your doctor’s name.</h2>
      <p class="lead">Dr. Sandeep Tiwari and Dr. Mahesh Tiwari lead Geeta Krishna Physiotherapy, both qualified MPT (PT).</p>
    </header>

    <div class="cards">
      {
        doctors.map((d, i) => (
          <article class="doc reveal" data-reveal="group" style={`--i:${i}`} aria-labelledby={`doc-${i}-name`}>
            <figure class="doc__photo">
              <div class="doc__media">
                <div class="doc__scale">
                  <ClinicImage photo={d.slot} alt={`Portrait of ${d.name}, ${d.role} at Geeta Krishna Physiotherapy`} sizes="(min-width:1024px) 520px, (min-width:640px) 50vw, 100vw">
                    <Placeholder label={`Portrait · ${d.name}`} icon="user-round" tone="sand" />
                  </ClinicImage>
                </div>
              </div>
              <span class="doc__idx" aria-hidden="true">{d.n} / 02</span>
              <figcaption class="doc__id">
                <span class="pill">{d.qualification}</span>
                <span class="role">{d.role}</span>
              </figcaption>
            </figure>

            <div class="doc__info">
              <h3 id={`doc-${i}-name`} class="h3 doc__name">{d.name}</h3>
              <dl class="doc__facts">
                <div>
                  <dt>Specialisation</dt>
                  <dd><span class="tbd">{d.specialisation}</span></dd>
                </div>
                <div>
                  <dt>About</dt>
                  <dd><span class="tbd">{d.bio}</span></dd>
                </div>
              </dl>
              <a
                class="btn btn-primary ask"
                href={whatsappLink(doctorMessage(d.name))}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Ask ${d.name} on WhatsApp`}
                data-track="whatsapp_click"
                data-location={`doctor-${i + 1}`}
              >
                <Icon name="message-circle" size={19} />
                Ask {d.short}
                <Icon name="arrow-right" size={18} class="icon-arrow" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
    </div>
  </div>
</section>

<style>
  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .relative {
    position: relative;
  }
  .layout {
    display: grid;
    gap: clamp(24px, 4vw, 40px);
  }
  .head {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    max-width: 38rem;
  }

  .cards {
    display: grid;
    gap: 36px;
  }
  .doc {
    --r: 24px;
    --d: calc(var(--i, 0) * 140ms);
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  /* The photograph is the hero of this section */
  .doc__photo {
    position: relative;
    margin: 0;
    height: clamp(320px, 92vw, 420px);
    border-radius: var(--r);
    isolation: isolate;
  }
  /* The shadow lives on its own layer so the portrait's wipe (clip-path) can't cut it off */
  .doc__photo::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--r);
    box-shadow: 0 28px 44px -30px rgb(12 59 54 / 0.5);
    transition: opacity 900ms ease-out;
    transition-delay: calc(var(--d) + 250ms);
    pointer-events: none;
  }
  .doc__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: var(--r);
    background: var(--color-sand);
    clip-path: inset(0 0 0 0 round var(--r));
    transition: clip-path 950ms var(--ease-soft);
    transition-delay: var(--d);
  }
  /* The photograph settles a touch slower than its wipe, so the two layers never move in lockstep */
  .doc__scale {
    position: absolute;
    inset: 0;
    transition: transform 1500ms var(--ease-soft);
    transition-delay: var(--d);
  }
  .doc__photo :global(.clinic-img) {
    transition: transform 900ms var(--ease-soft);
  }
  .doc:hover .doc__photo :global(.clinic-img) {
    transform: scale(1.02);
  }
  .doc__idx {
    position: absolute;
    z-index: 3;
    top: 14px;
    left: 14px;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: rgb(12 59 54 / 0.78);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--color-ivory);
    /* drifts into place on its own clock, a little after the wipe starts */
    transition:
      opacity 900ms ease-out,
      transform 1300ms var(--ease-soft);
    transition-delay: calc(var(--d) + 380ms);
  }
  .doc__id {
    position: absolute;
    z-index: 3;
    left: 14px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.4rem 0.85rem 0.4rem 0.4rem;
    border-radius: 999px;
    background: rgb(12 59 54 / 0.78);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--color-ivory);
    transition:
      opacity 700ms ease-out,
      transform 700ms ease-out;
    transition-delay: calc(var(--d) + 620ms);
  }
  .pill {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--color-sand);
    color: var(--color-pine);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }
  .role {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* Name and details follow the portrait by ~110ms and travel a shorter, quicker path */
  .doc__info {
    display: grid;
    gap: 0.9rem;
    transition:
      opacity 700ms ease-out,
      transform 700ms ease-out;
    transition-delay: calc(var(--d) + 110ms);
  }

  /* Hidden states — only when JS is running; the observer adds .is-in once per entry */
  :global(.js) .doc:not(.is-in) .doc__media {
    clip-path: inset(0 0 100% 0 round var(--r));
  }
  :global(.js) .doc:not(.is-in) .doc__scale {
    transform: scale(1.08);
  }
  :global(.js) .doc:not(.is-in) .doc__photo::before {
    opacity: 0;
  }
  :global(.js) .doc:not(.is-in) .doc__idx {
    opacity: 0;
    transform: translate3d(-10px, -8px, 0);
  }
  :global(.js) .doc:not(.is-in) .doc__id {
    opacity: 0;
    transform: translate3d(0, 8px, 0);
  }
  :global(.js) .doc:not(.is-in) .doc__info {
    opacity: 0;
    transform: translate3d(0, 18px, 0);
  }
  .doc__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin: 0;
    padding-block: 0.9rem;
    border-block: 1px solid rgb(12 59 54 / 0.14);
  }
  .doc__facts div {
    display: grid;
    align-content: start;
    gap: 0.3rem;
  }
  .doc__facts dt {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-ink) 58%, transparent);
  }
  .doc__facts dd {
    margin: 0;
  }
  .doc__facts :global(.tbd) {
    font-size: 0.75rem;
  }

  .ask {
    justify-self: start;
    min-height: 48px;
  }

  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px;
      align-items: start;
    }
    .doc__photo {
      height: 400px;
    }
  }
  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 32px;
      align-items: start;
    }
    .head {
      grid-column: 1 / span 4;
      padding-top: 0.5rem;
    }
    .cards {
      grid-column: 5 / span 8;
      gap: 28px;
    }
    .doc {
      --r: 26px;
    }
    .doc__photo {
      height: 460px;
    }
    /* Staggered editorial offset */
    .doc:nth-child(2) {
      margin-top: 48px;
    }
  }
</style>
