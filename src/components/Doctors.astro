---
import ClinicImage from './ClinicImage.astro';
import Placeholder from './Placeholder.astro';
import Icon from './Icon.astro';
import { doctorMessage, doctors, whatsappLink } from '../data/site';
---

<section id="doctors" class="section surface-ivory" data-section data-ambient aria-labelledby="doctors-title">
  <div class="bg" aria-hidden="true">
    <span class="orb" style="--s:520px; --c:rgb(233 223 201 / 1); left:-180px; top:8%; --dur:44s"></span>
  </div>

  <div class="container-site relative">
    <div class="layout">
    <header class="head reveal">
      <p class="eyebrow">03 / Doctors</p>
      <h2 id="doctors-title" class="h2">Meet the clinic leads.</h2>
      <p class="lead">Dr. Sandeep Tiwari and Dr. Mahesh Tiwari lead Geeta Krishna Physiotherapy, both qualified MPT (PT).</p>
    </header>

    <div class="cards">
      {
        doctors.map((d, i) => (
          <article class="doc reveal" style={`--i:${i}`} aria-labelledby={`doc-${i}-name`}>
            <figure class="doc__photo">
              <ClinicImage photo={d.slot} alt={`Portrait of ${d.name}, ${d.role} at Geeta Krishna Physiotherapy`} sizes="(min-width:1024px) 520px, (min-width:640px) 50vw, 100vw">
                <Placeholder label={`Portrait · ${d.name}`} icon="user-round" tone="sand" />
              </ClinicImage>
              <span class="doc__idx" aria-hidden="true">{d.n} / 02</span>
              <figcaption class="doc__id">
                <span class="pill">{d.qualification}</span>
                <span class="role">{d.role}</span>
              </figcaption>
            </figure>

            <div class="doc__info">
              <h3 id={`doc-${i}-name`} class="h3 doc__name">{d.name}</h3>
              <dl class="doc__facts">
                <div>
                  <dt>Specialisation</dt>
                  <dd><span class="tbd">{d.specialisation}</span></dd>
                </div>
                <div>
                  <dt>About</dt>
                  <dd><span class="tbd">{d.bio}</span></dd>
                </div>
              </dl>
              <a
                class="ask"
                href={whatsappLink(doctorMessage(d.name))}
                target="_blank"
                rel="noopener noreferrer"
                data-track="whatsapp_click"
                data-location={`doctor-${i + 1}`}
              >
                <Icon name="message-circle" size={18} />
                <span>Ask about care with {d.name}</span>
                <Icon name="arrow-right" size={16} class="icon-arrow" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
    </div>
  </div>
</section>

<style>
  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .relative {
    position: relative;
  }
  .layout {
    display: grid;
    gap: clamp(24px, 4vw, 40px);
  }
  .head {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    max-width: 38rem;
  }

  .cards {
    display: grid;
    gap: 36px;
  }
  .doc {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  /* The photograph is the hero of this section */
  .doc__photo {
    position: relative;
    margin: 0;
    height: clamp(320px, 92vw, 420px);
    overflow: hidden;
    border-radius: 24px;
    background: var(--color-sand);
    box-shadow: 0 28px 44px -30px rgb(12 59 54 / 0.5);
    isolation: isolate;
  }
  .doc__photo :global(.clinic-img) {
    transition: transform 900ms var(--ease-soft);
  }
  .doc:hover .doc__photo :global(.clinic-img) {
    transform: scale(1.02);
  }
  .doc__idx {
    position: absolute;
    z-index: 3;
    top: 14px;
    left: 14px;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: rgb(12 59 54 / 0.78);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--color-ivory);
  }
  .doc__id {
    position: absolute;
    z-index: 3;
    left: 14px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.4rem 0.85rem 0.4rem 0.4rem;
    border-radius: 999px;
    background: rgb(12 59 54 / 0.78);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--color-ivory);
  }
  .pill {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--color-sand);
    color: var(--color-pine);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }
  .role {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .doc__info {
    display: grid;
    gap: 0.9rem;
  }
  .doc__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin: 0;
    padding-block: 0.9rem;
    border-block: 1px solid rgb(12 59 54 / 0.14);
  }
  .doc__facts div {
    display: grid;
    align-content: start;
    gap: 0.3rem;
  }
  .doc__facts dt {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-ink) 58%, transparent);
  }
  .doc__facts dd {
    margin: 0;
  }
  .doc__facts :global(.tbd) {
    font-size: 0.75rem;
  }

  .ask {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: start;
    padding: 0.35rem 0;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-teal);
    text-decoration: none;
    border-bottom: 1.5px solid transparent;
    transition: border-color var(--dur-normal) ease;
  }
  .ask:hover {
    border-color: currentColor;
  }
  .ask:hover :global(.icon-arrow) {
    transform: translateX(3px);
  }
  .ask :global(.icon-arrow) {
    transition: transform var(--dur-normal) var(--ease-soft);
  }

  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px;
      align-items: start;
    }
    .doc__photo {
      height: 400px;
    }
  }
  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 32px;
      align-items: start;
    }
    .head {
      grid-column: 1 / span 4;
      padding-top: 0.5rem;
    }
    .cards {
      grid-column: 5 / span 8;
      gap: 28px;
    }
    .doc__photo {
      height: 460px;
      border-radius: 26px;
    }
    /* Staggered editorial offset */
    .doc:nth-child(2) {
      margin-top: 48px;
    }
  }
</style>
