---
import Icon from './Icon.astro';
import { clinic, links, reviews } from '../data/site';

// Only clinic-approved reviews are ever shown. While none are supplied we render a clearly
// marked placeholder instead of inventing a quote.
const approved = reviews;
const multi = approved.length > 1;
---

<section id="reviews" class="section surface-pine on-dark" data-section data-ambient aria-labelledby="reviews-title">
  <div class="bg" aria-hidden="true">
    <span class="orb" style="--s:620px; --c:rgb(15 118 110 / .5); left:-180px; top:-140px; --dur:36s"></span>
    <span class="orb" style="--s:520px; --c:rgb(15 118 110 / .32); right:-160px; bottom:-120px; --dur:42s"></span>
    <div class="dots"></div>
  </div>

  <div class="container-site relative">
    <div class="top">
      <header class="top__copy reveal">
        <p class="eyebrow">Patient experiences</p>
        <h2 id="reviews-title" class="h2">In patients’ own words.</h2>
      </header>

      <div class="score reveal" style="--i:1">
        <span class="score__num">{clinic.rating.value}</span>
        <div class="score__meta">
          <span class="score__stars" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => <Icon name="star" size={18} class="star" />)}
          </span>
          <span class="score__count">{clinic.rating.count} Google reviews</span>
          <span class="sr-only">Rated {clinic.rating.value} out of 5 stars</span>
        </div>
      </div>
    </div>

    <div class="feature glass-dark reveal" style="--i:1">
      <span class="feature__mark" aria-hidden="true">“</span>

      <div class="feature__main">
        {
          approved.length === 0 && (
            <figure class="quote">
              <blockquote>
                <p class="quote__text quote__text--ph" data-placeholder>[PATIENT STORY PLACEHOLDER — CLINIC CONTENT REQUIRED]</p>
              </blockquote>
              <figcaption class="quote__cite">
                <span class="tbd">[TBD - approved patient label]</span>
              </figcaption>
            </figure>
          )
        }

        {
          approved.length > 0 && (
            <div class="slider" data-slider role="region" aria-roledescription="carousel" aria-label="Patient reviews">
              <div class="slider__track" data-slider-track tabindex={multi ? 0 : undefined}>
                {approved.map((r, i) => (
                  <figure class="slide quote" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${approved.length}`}>
                    <blockquote>
                      <p class="quote__text">{r.quote}</p>
                    </blockquote>
                    <figcaption class="quote__cite">
                      <strong>{r.author}</strong>
                      {r.source && <span> · {r.source}</span>}
                    </figcaption>
                  </figure>
                ))}
              </div>
              {multi && (
                <div class="slider__ctrl">
                  <button type="button" class="round" data-slider-prev aria-label="Previous review" data-track="review_interaction">
                    <Icon name="chevron-left" size={20} />
                  </button>
                  <button type="button" class="round" data-slider-next aria-label="Next review" data-track="review_interaction">
                    <Icon name="chevron-right" size={20} />
                  </button>
                </div>
              )}
            </div>
          )
        }
      </div>

      <aside class="feature__side" aria-label="Google reviews">
        <span class="score__stars" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => <Icon name="star" size={20} class="star" />)}
        </span>
        <p class="feature__google">Google</p>
        <p class="feature__note">{clinic.rating.value} stars from {clinic.rating.count} reviews</p>
        <a class="link-arrow" href={links.reviews} target="_blank" rel="noopener noreferrer" data-track="review_interaction" data-location="reviews-link">
          Read all reviews
          <Icon name="arrow-up-right" size={18} />
        </a>
      </aside>
    </div>
  </div>
</section>

<style>
  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .relative {
    position: relative;
  }
  .top {
    display: grid;
    gap: 28px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .top__copy {
    display: grid;
    gap: 1.1rem;
    max-width: 34rem;
  }
  .score {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  .score__num {
    font: 400 clamp(4.5rem, 3.4rem + 5vw, 7.5rem) / 0.9 var(--font-serif);
    letter-spacing: -0.03em;
    color: var(--color-ivory);
  }
  .score__meta {
    display: grid;
    gap: 0.35rem;
  }
  .score__stars {
    display: inline-flex;
    gap: 3px;
    color: var(--color-sand);
  }
  .score__stars :global(.star) {
    fill: currentColor;
    stroke-width: 1.5;
  }
  .score__count {
    font-size: 1.0625rem;
    font-weight: 700;
    color: rgb(250 248 242 / 0.9);
  }

  /* Featured review */
  .feature {
    position: relative;
    display: grid;
    gap: 28px;
    padding: 1.6rem 1.4rem 1.6rem;
    border-radius: 28px;
    overflow: hidden;
  }
  .feature__mark {
    position: absolute;
    top: -0.1em;
    left: 0.15em;
    font: 400 clamp(9rem, 7rem + 8vw, 15rem) / 1 var(--font-serif);
    color: var(--color-sand);
    opacity: 0.12;
    pointer-events: none;
    user-select: none;
  }
  .feature__main {
    position: relative;
    min-width: 0;
    padding-top: 2.2rem;
  }
  .quote {
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }
  .quote blockquote {
    margin: 0;
  }
  .quote__text {
    font: 400 clamp(1.375rem, 1.1rem + 1.4vw, 2.125rem) / 1.3 var(--font-serif);
    letter-spacing: -0.005em;
    color: var(--color-ivory);
  }
  .quote__text--ph {
    display: inline-block;
    padding: 1rem 1.25rem;
    border: 1px dashed rgb(233 223 201 / 0.5);
    border-radius: 16px;
    font: 700 0.9375rem/1.5 var(--font-sans);
    letter-spacing: 0.04em;
    color: var(--color-sand);
  }
  .quote__cite {
    font-size: 0.9375rem;
    color: rgb(250 248 242 / 0.74);
  }
  .quote__cite strong {
    color: var(--color-ivory);
  }

  .feature__side {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(250 248 242 / 0.14);
  }
  .feature__google {
    font: 400 1.75rem/1.1 var(--font-serif);
    margin-top: 0.25rem;
  }
  .feature__note {
    font-size: 0.9375rem;
    color: rgb(250 248 242 / 0.72);
    margin-bottom: 0.6rem;
  }

  /* Slider — scroll-snap gives native touch swipe; arrows for desktop; no autoplay */
  .slider__track {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .slider__track::-webkit-scrollbar {
    display: none;
  }
  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }
  .slider__ctrl {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .round {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgb(250 248 242 / 0.28);
    background: rgb(250 248 242 / 0.06);
    color: var(--color-ivory);
    cursor: pointer;
    transition:
      transform var(--dur-fast) var(--ease-soft),
      background-color var(--dur-normal) ease;
  }
  .round:hover {
    background: rgb(250 248 242 / 0.16);
  }
  .round:active {
    transform: scale(0.94);
  }

  @media (min-width: 768px) {
    .top {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .feature {
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 0;
      padding: 2.5rem 0 2.5rem 2.75rem;
    }
    .feature__side {
      padding: 0.5rem 2.25rem;
      border-top: 0;
      border-left: 1px solid rgb(250 248 242 / 0.14);
    }
    .feature__main {
      padding-right: 2.75rem;
    }
  }
</style>
