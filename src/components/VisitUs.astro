---
import Depth from './Depth.astro';
import DarkFx from './DarkFx.astro';
import Icon from './Icon.astro';
import { clinic, hours, links } from '../data/site';
const { address } = clinic;
---

<section id="visit" class="section curve surface-pine on-dark" data-section data-ambient data-hide-sticky aria-labelledby="visit-title">
  <Depth tone="dark" mirror drift={false} />
  <DarkFx />

  <div class="container-site grid">
    <div class="info reveal" data-reveal="left">
      <p class="eyebrow">10 / Visit us</p>
      <h2 id="visit-title" class="h2">In your neighbourhood, not across town.</h2>

      <address class="addr">
        <p class="addr__name">{clinic.name}</p>
        <p>{address.street}</p>
        <p>{address.area}</p>
        <p>{address.city}, {address.region} {address.postalCode}</p>
        <p class="addr__phone">
          <Icon name="phone" size={16} />
          <a href={links.tel} data-track="phone_click" data-location="visit">{clinic.phone.display}</a>
        </p>
      </address>

      <div class="hours glass-dark">
        <p class="hours__title"><Icon name="clock" size={15} /> Hours</p>
        <dl>
          <div><dt>{hours.days}</dt><dd>{hours.sessions[0]}</dd></div>
          <div><dt>{hours.days}</dt><dd>{hours.sessions[1]}</dd></div>
          <div class="is-closed"><dt>Sunday</dt><dd>Closed</dd></div>
        </dl>
      </div>

      <div class="actions">
        <a class="btn btn-primary" href={links.directions} target="_blank" rel="noopener noreferrer" data-track="directions_click" data-location="visit">
          <Icon name="navigation" size={18} />
          Get Directions
          <Icon name="arrow-right" size={18} class="icon-arrow" />
        </a>
        <a class="btn btn-glass" href={links.tel} data-track="phone_click" data-location="visit">
          <Icon name="phone" size={18} /> Call
        </a>
        <a class="btn btn-glass" href={links.whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-location="visit">
          <Icon name="message-circle" size={18} /> WhatsApp
        </a>
      </div>
    </div>

    <div class="map reveal" data-reveal="right" style="--i:1">
      <a class="map__stage" href={links.directions} target="_blank" rel="noopener noreferrer" aria-label={`Open ${clinic.name} in Google Maps (opens in a new tab)`} data-track="directions_click" data-location="visit-map">
        <!-- Lightweight, abstract preview — a plain link, no embedded map or third-party script. -->
        <svg class="map__art" viewBox="0 0 600 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
          <defs>
            <radialGradient id="map-bg" cx="50%" cy="45%" r="75%">
              <stop offset="0" stop-color="#14574f"></stop>
              <stop offset="1" stop-color="#0a332f"></stop>
            </radialGradient>
          </defs>
          <rect width="600" height="520" fill="url(#map-bg)"></rect>
          <g fill="#E9DFC9" fill-opacity=".05">
            <rect x="40" y="40" width="150" height="90" rx="10"></rect>
            <rect x="220" y="40" width="110" height="120" rx="10"></rect>
            <rect x="360" y="60" width="190" height="80" rx="10"></rect>
            <rect x="40" y="170" width="110" height="130" rx="10"></rect>
            <rect x="420" y="180" width="130" height="110" rx="10"></rect>
            <rect x="60" y="340" width="170" height="120" rx="10"></rect>
            <rect x="380" y="350" width="170" height="110" rx="10"></rect>
          </g>
          <ellipse cx="170" cy="250" rx="62" ry="40" fill="#0F766E" fill-opacity=".28"></ellipse>
          <g fill="none" stroke="#E9DFC9" stroke-linecap="round">
            <path d="M-10 150 C 140 140, 260 170, 610 120" stroke-opacity=".22" stroke-width="10"></path>
            <path d="M-10 320 C 180 300, 360 340, 610 300" stroke-opacity=".22" stroke-width="10"></path>
            <path d="M200 -10 C 190 150, 230 330, 210 530" stroke-opacity=".2" stroke-width="9"></path>
            <path d="M400 -10 C 410 140, 380 340, 405 530" stroke-opacity=".2" stroke-width="9"></path>
            <path d="M-10 420 L 610 440" stroke-opacity=".1" stroke-width="5"></path>
            <path d="M300 -10 L 305 530" stroke-opacity=".1" stroke-width="5"></path>
          </g>
          <g transform="translate(300 250)">
            <circle r="24" fill="none" stroke="#E9DFC9" stroke-opacity=".5" stroke-width="1.5"></circle>
            <circle r="40" fill="none" stroke="#E9DFC9" stroke-opacity=".22" stroke-width="1" stroke-dasharray="2 6"></circle>
            <circle r="9" fill="#EA580C" stroke="#FAF8F2" stroke-width="3"></circle>
          </g>
        </svg>

        <div class="map__label glass">
          <Icon name="map-pin" size={16} />
          <div>
            <strong>{clinic.name}</strong>
            <span>Near Deva Palace, Gomti Nagar</span>
          </div>
        </div>

        <span class="map__open btn btn-glass btn-sm">
          <Icon name="map" size={18} />
          Open in Google Maps
          <Icon name="arrow-up-right" size={16} class="icon-arrow" />
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .grid {
    position: relative;
    display: grid;
    gap: clamp(32px, 5vw, 56px);
    align-items: stretch;
  }
  .info {
    display: grid;
    gap: 1.6rem;
    align-content: start;
  }

  .addr {
    font-style: normal;
    display: grid;
    gap: 0.15rem;
    font-size: 1.0625rem;
    color: rgb(250 248 242 / 0.82);
  }
  .addr p {
    margin: 0;
  }
  .addr__name {
    margin-bottom: 0.4rem !important;
    font: 400 1.5rem/1.2 var(--font-serif);
    color: var(--color-ivory);
  }
  .addr__phone {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.7rem !important;
    font-weight: 700;
  }
  .addr__phone a {
    color: var(--color-ivory);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgb(250 248 242 / 0.4);
  }

  .hours {
    padding: 1.1rem 1.25rem 1.2rem;
    border-radius: 20px;
  }
  .hours__title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.6rem;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-sand);
  }
  .hours dl {
    margin: 0;
  }
  .hours dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-top: 1px solid rgb(250 248 242 / 0.1);
  }
  .hours dt {
    color: rgb(250 248 242 / 0.7);
  }
  .hours dd {
    margin: 0;
    font-weight: 700;
  }
  .hours .is-closed dd {
    color: var(--color-sand);
  }

  .actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .actions .btn:first-child {
    grid-column: 1 / -1;
  }

  /* Map */
  .map {
    min-height: 340px;
  }
  .map__stage {
    position: relative;
    display: block;
    height: 100%;
    min-height: 340px;
    overflow: hidden;
    border-radius: 28px;
    border: 1px solid rgb(250 248 242 / 0.16);
    box-shadow: 0 30px 60px -34px rgb(0 0 0 / 0.6);
    background: #0a332f;
    isolation: isolate;
  }
  .map__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .map__label {
    position: absolute;
    left: 14px;
    top: 14px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    max-width: calc(100% - 28px);
    padding: 0.6rem 0.9rem;
    border-radius: 16px;
    color: var(--color-pine);
    font-size: 0.8125rem;
    line-height: 1.3;
  }
  .map__label :global(.icon) {
    color: var(--color-teal);
  }
  .map__label div {
    display: grid;
  }
  .map__label span {
    color: color-mix(in srgb, var(--color-ink) 70%, transparent);
  }
  .map__open {
    position: absolute;
    inset-inline: 0;
    bottom: 16px;
    z-index: 2;
    width: fit-content;
    margin-inline: auto;
    background: rgb(12 59 54 / 0.6);
    transition: background-color var(--dur-normal) ease, border-color var(--dur-normal) ease;
  }
  .map__stage:hover .map__open {
    background: rgb(12 59 54 / 0.85);
    border-color: rgb(250 248 242 / 0.5);
  }
  .map__stage:hover .map__open :global(.icon-arrow) {
    transform: translate(2px, -2px);
  }

  @media (min-width: 640px) {
    .actions {
      grid-template-columns: auto auto auto;
      justify-content: start;
    }
    .actions .btn:first-child {
      grid-column: auto;
    }
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 32px;
    }
    .info {
      grid-column: 1 / span 5;
    }
    .map {
      grid-column: 7 / span 6;
      min-height: 440px;
    }
  }
</style>
